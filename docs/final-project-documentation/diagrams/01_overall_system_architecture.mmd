        Controllers["Controllers: Auth, Task, Sync, Reminder, Assistant, Health"]
    end

    subgraph ServiceLayer ["3. Core Services Layer (Business Logic)"]
        OAuthSvc["Google OAuth Service (Token Exchange & Auto-Refresh)"]
        GmailSvc["Gmail Service (MIME Parsing, Pagination, Sync)"]
        CalSvc["Calendar Service (Timed & All-Day Event Sync)"]
        AutoSyncSvc["Auto-Sync Background Service (Periodic 30s Runner)"]
        AISvc["AI Responsibility Generation Service (Zod Parsing & Deduplication)"]
        ReminderSvc["Smart Reminder Service (IST Timezone & Condition Evaluator)"]
        AssistantSvc["Ask LifeSynch AI Service (Intent Analyzer & Grounded Fallback)"]
    end

    subgraph ExternalServices ["4. External Integrations"]
        GoogleAuth["Google Identity (OAuth 2.0)"]
        GoogleGmail["Google Gmail API (v1 REST)"]
        GoogleCalendar["Google Calendar API (v3 REST)"]
        GeminiAPI["Google Gemini API (generativelanguage.googleapis.com)"]
    end

    subgraph DataLayer ["5. Database Layer (Supabase PostgreSQL)"]
        SupaClient["Supabase Admin Client (Service Role)"]
        RLS["Row Level Security (RLS Policies)"]
        Tables["Tables: users, connected_accounts, emails, calendar_events, responsibilities, notifications, sync_state"]
