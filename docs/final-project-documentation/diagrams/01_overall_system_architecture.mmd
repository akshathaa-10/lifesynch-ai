graph TD
    subgraph ClientLayer ["1. Client Layer (Frontend SPA)"]
        UI["React 18 + TypeScript + Vite + Tailwind CSS"]
        Pages["Pages: Login, Dashboard, Responsibilities, Worth Knowing, Assistant, Notifications"]
        AuthContext["Auth Context (JWT stored in localStorage)"]
        ApiClient["Axios API Client (Bearer Token Auth Interceptor)"]
    end

    subgraph ServerLayer ["2. Server Layer (Node.js & Express Backend)"]
        Server["Express HTTP Server (Port 5000)"]
        Middlewares["Middlewares: CORS, requireAuth, Logger Sanitizer, Error Handler"]
