# ==============================================
# LifeSynch AI - Frontend Environment Configuration
# ==============================================

# Backend API Base URL
# Leave empty in local dev to use Vite proxy (/api), or specify full URL in production
VITE_API_URL=

# Supabase Public Keys (safe for browser)
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# NOTE: NEVER put Google Client Secret or LLM API keys here!
